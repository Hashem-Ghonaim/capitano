{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/uploads/(.*)",
      "dest": "https://res.cloudinary.com/jjxkbp4v/image/upload/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "regions": [
    "lhr1"
  ]
}